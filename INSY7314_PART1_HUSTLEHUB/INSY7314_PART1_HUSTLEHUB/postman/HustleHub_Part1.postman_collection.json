{
  "info": {
    "name": "HustleHub+ Part 1 - Secure Foundations",
    "description": "Demonstrates registration, login, JWT-protected routes, and invalid/edge-case handling for the HustleHub+ Part 1 backend (INSY7314).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5443" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns created user without password', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.user.email).to.eql('ron@example.com');",
              "  pm.expect(body.data.user).to.not.have.property('passwordHash');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ron@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"role\": \"freelancer\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Register - Duplicate Email (expect 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));",
              "pm.test('No internal details leaked', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(JSON.stringify(body)).to.not.include('at Object');",
              "  pm.expect(JSON.stringify(body)).to.not.include('.js:');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ron@example.com\",\n  \"password\": \"Passw0rd123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Register - Invalid Input (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Returns field-level validation errors', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns a JWT', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.token.split('.').length).to.eql(3);",
              "  pm.collectionVariables.set('authToken', body.data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ron@example.com\",\n  \"password\": \"Passw0rd123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Login - Wrong Password (expect 401, generic message)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Message does not reveal which field was wrong', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.message).to.eql('Invalid email or password.');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ron@example.com\",\n  \"password\": \"WrongPass1\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Login - Unknown Email (expect 401, same generic message)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"doesnotexist@example.com\",\n  \"password\": \"WrongPass1\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Protected Route - With Valid Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": "{{baseUrl}}/api/auth/profile"
      }
    },
    {
      "name": "Protected Route - No Token (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/profile"
      }
    },
    {
      "name": "Protected Route - Malformed Token (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer garbage.token.here" }],
        "url": "{{baseUrl}}/api/auth/profile"
      }
    },
    {
      "name": "Unknown Route (expect 404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/does-not-exist"
      }
    }
  ]
}
